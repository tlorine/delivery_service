{
  "name": "@delivery/mobile",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell for Android and iOS: the storefront SPA build (ADR-0005, variant A)",
  "scripts": {
    "build:web": "pnpm --filter @nextorders/web-app run generate:mobile",
    "sync": "pnpm run build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "catalog:mobile",
    "@capacitor/app": "catalog:mobile",
    "@capacitor/core": "catalog:mobile",
    "@capacitor/ios": "catalog:mobile",
    "@capacitor/preferences": "catalog:mobile"
  },
  "devDependencies": {
    "@capacitor/cli": "catalog:mobile"
  }
}
