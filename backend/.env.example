# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application role: not the owner of tables, no BYPASSRLS (ADR-0002)
DATABASE_URL=postgresql+asyncpg://delivery_app:delivery_app@localhost:5432/delivery
# Owner role: migrations and the platform CLI only
MIGRATOR_DATABASE_URL=postgresql+asyncpg://delivery:delivery@localhost:5432/delivery

# Required in production. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SESSION_SECRET=
ENCRYPTION_KEY=

# Behind the reverse proxy only:
TRUST_FORWARDED_HOST=false
# JSON list. Hosts where the mobile app sends X-Tenant: <slug>
PLATFORM_API_HOSTS=["api.localhost"]
# JSON list. Origins of the admin panel and the Capacitor app
CORS_ORIGINS=[]
ADMIN_BASE_URL=http://localhost:3001
